                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Response under 3 seconds\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const body = pm.response.json();",
                  "pm.test(\"success is true\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"Account has admin role\", () => pm.expect(body.data.role).to.eql(\"admin\"));"

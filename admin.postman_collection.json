  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "09.1 Admin login (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "description": "JSON Type",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{URL}}/api/v1/auth/login",
              "host": [
                "{{URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ADMIN_EMAIL}}\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (const key of [\"USER_ID\", \"BOOKING_ID_2\", \"BOOKING_ID_3\"]) { if (!pm.environment.get(key)) throw new Error(\"Run the User collection first with the same selected environment. Missing: \" + key); }",
                  "if (!pm.environment.get(\"ADMIN_EMAIL\") || !pm.environment.get(\"ADMIN_PASSWORD\")) throw new Error(\"Set ADMIN_EMAIL and ADMIN_PASSWORD in the selected environment or collection Variables\");"
                ],
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Response under 3 seconds\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const body = pm.response.json();",
                  "pm.test(\"success is true\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"Admin token returned\", () => pm.expect(body.token).to.be.a(\"string\").and.not.empty);",
                  "if (pm.response.code === 200 && body.success === true) {",
                  "pm.environment.set(\"ADMIN_TOKEN\", body.token);",
                  "}"
                ],
                "packages": {},
                "requests": {}
              }
            }
          ],
          "response": []
        },
        {

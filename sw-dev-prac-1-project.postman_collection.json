      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"TEST_EMAIL\", `newman_${Date.now()}@example.com`);\r",
                  "pm.environment.set(\"TEST_PASSWORD\", \"NewmanPass123\");\r",
                  "pm.environment.set(\"TEST_TEL\", \"0812345678\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response time is under 3 seconds\", () => {\r",
                  "  pm.expect(pm.response.responseTime).to.be.below(3000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", () => {\r",
                  "  pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Register returns 201\", () => {\r",
                  "  pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Register returns a token\", () => {\r",
                  "  pm.expect(body.success).to.eql(true);\r",
                  "  pm.expect(body.token).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"USER_TOKEN\", body.token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "description": "JSON Type",
                "type": "text"
              }

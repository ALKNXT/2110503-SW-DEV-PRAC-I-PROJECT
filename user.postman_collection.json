                  "if (!Array.isArray(body.data) || !body.data.length) { throw new Error(\"Create an active provider before running this demo\"); }",
                  "const preferredId = pm.environment.get(\"PROVIDER_ID\") || pm.collectionVariables.get(\"PROVIDER_ID\");",
                  "const provider = body.data.find(provider => provider._id === preferredId) || body.data[0];",
